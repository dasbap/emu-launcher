#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_module_dir() {
  local paired_dir
  if [[ -n "${EMU_LIB_DIR:-}" && -d "$EMU_LIB_DIR" ]]; then
    printf '%s\n' "$EMU_LIB_DIR"
    return 0
  fi
  if [[ -d "$SCRIPT_DIR/lib/emu" ]]; then
    printf '%s\n' "$SCRIPT_DIR/lib/emu"
    return 0
  fi
  paired_dir="$(cd "$SCRIPT_DIR/../lib/emu" 2>/dev/null && pwd)" || paired_dir=""
  if [[ -n "$paired_dir" && -d "$paired_dir" ]]; then
    printf '%s\n' "$paired_dir"
    return 0
  fi
  if [[ -d "$HOME/.local/lib/emu" ]]; then
    printf '%s\n' "$HOME/.local/lib/emu"
    return 0
  fi
  if [[ -d "/usr/local/lib/emu" ]]; then
    printf '%s\n' "/usr/local/lib/emu"
    return 0
  fi
  return 1
}

MODULE_DIR="$(find_module_dir)" || {
  echo "Erreur: modules emu introuvables. Réinstallez avec ./emu -i." >&2
  exit 1
}

# shellcheck source=lib/emu/core.bash
source "$MODULE_DIR/core.bash"
# shellcheck source=lib/emu/config.bash
source "$MODULE_DIR/config.bash"
# shellcheck source=lib/emu/launch.bash
source "$MODULE_DIR/launch.bash"
# shellcheck source=lib/emu/library.bash
source "$MODULE_DIR/library.bash"
# shellcheck source=lib/emu/commands.bash
source "$MODULE_DIR/commands.bash"

emu_main "$@"
